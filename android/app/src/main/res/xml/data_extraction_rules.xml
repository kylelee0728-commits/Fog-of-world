<?xml version="1.0" encoding="utf-8"?>
<!-- 只備份足跡與設定；沒列進來的（例如 osmdroid 圖磚快取）本來就不會備份 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="fog/" />
        <include domain="sharedpref" path="fow_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="fog/" />
        <include domain="sharedpref" path="fow_settings.xml" />
    </device-transfer>
</data-extraction-rules>
